# Admin Backend - Federated Learning Network
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Blockchain (Ethereum Sepolia Testnet)
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS

# IPFS (Pinata)
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Model Configuration
MODEL_PATH=../model/best_histopathology_model.pth

# Python (for FedAvg aggregation)
PYTHON_PATH=python3
