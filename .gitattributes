# Git LFS tracked patterns for large model and dataset files
# Track common ML model formats and large archives/directories
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.ckpt.* filter=lfs diff=lfs merge=lfs -text
*.pth.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# Track model and uploads directories recursively
/Model/** filter=lfs diff=lfs merge=lfs -text
/uploads/** filter=lfs diff=lfs merge=lfs -text
# If there are any other large binary artifacts, add patterns here
# e.g. *.bin, *.pb, *.onnx, etc.
