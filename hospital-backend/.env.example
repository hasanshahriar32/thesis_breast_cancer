# Hospital Federated Learning Backend Environment Configuration

# Hospital Configuration
HOSPITAL_ID=HOSP_004_SINGAPORE
HOSPITAL_NAME=Singapore General Hospital
HOSPITAL_REGION=Asia
HOSPITAL_COUNTRY=Singapore
HOSPITAL_CITY=Singapore

# Network Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration (for patient data storage)
MONGODB_URI=mongodb://localhost:27017/hospital_federated_db
MONGODB_TEST_URI=mongodb://localhost:27017/hospital_federated_test_db

# Blockchain Configuration
ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
GAS_LIMIT=500000
MAX_FEE_PER_GAS=50000000000
MAX_PRIORITY_FEE_PER_GAS=2000000000

# IPFS Configuration
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your-32-character-encryption-key-here
IV_LENGTH=16
PBKDF2_ITERATIONS=100000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-signing-key-here
JWT_EXPIRE=24h

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads
PROCESSED_PATH=./processed
MODELS_PATH=./models

# ML Model Configuration
BATCH_SIZE=32
EPOCHS=50
LEARNING_RATE=0.0001
VALIDATION_SPLIT=0.2
EARLY_STOPPING_PATIENCE=10

# Feature Extraction Configuration
FEATURE_DIMENSIONS=3840
XRAY_FEATURES=1280
HISTO_FEATURES=1280
ULTRASOUND_FEATURES=1280

# Privacy Configuration
DIFFERENTIAL_PRIVACY_EPSILON=1.0
DIFFERENTIAL_PRIVACY_DELTA=1e-5
PHI_ANONYMIZATION=true

# Oracle Configuration
CHAINLINK_ORACLE_ADDRESS=0x...
ORACLE_FEE_ETH=0.001
ORACLE_JOB_ID=d5270d1c311941d0b08bead21fea7747

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/hospital-backend.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Development Configuration
AUTO_GENERATE_SAMPLE_DATA=true
MOCK_BLOCKCHAIN=false
MOCK_IPFS=false