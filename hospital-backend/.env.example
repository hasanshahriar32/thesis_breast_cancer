# Hospital Federated Learning Backend - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values

# Hospital Identity
HOSPITAL_ID=1
HOSPITAL_NAME=Boston General Hospital
HOSPITAL_REGION=North America

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hospital_federated_learning

# Blockchain (Ethereum Sepolia Testnet)
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=your_hospital_wallet_private_key
CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS

# IPFS (Pinata)
PINATA_JWT=your_pinata_jwt_token
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Model
MODEL_PATH=../model/best_histopathology_model.pth
PYTHON_PATH=python3
MIN_SAMPLES=100

# Security & Encryption
ENCRYPT_FILES=true
ENCRYPT_PATIENT_DATA=true
# ENCRYPTION_KEY=auto_generated_if_not_set

# Storage (defaults to local filesystem)
# Set BLOB_READ_WRITE_TOKEN only if you want Vercel Blob Storage
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
AUTO_GENERATE_SAMPLE_DATA=true
MOCK_BLOCKCHAIN=false
MOCK_IPFS=false