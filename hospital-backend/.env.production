# Hospital 4 Backend Environment Configuration
# Copy this file to .env and update with your values

# ===== HOSPITAL CONFIGURATION =====
HOSPITAL_ID=4
HOSPITAL_NAME="General Hospital 4"
HOSPITAL_REGION="North America"
HOSPITAL_ADDRESS="456 Medical Center Drive, Boston, MA 02115"
HOSPITAL_EMAIL="federated@hospital4.org"

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== DATABASE CONFIGURATION =====
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hospital_federated_learning

# ===== BLOCKCHAIN CONFIGURATION =====
# Use Sepolia testnet for development
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID
PRIVATE_KEY=your-ethereum-private-key-here
CONTRACT_ADDRESS=0x1BE44922c9505E492eA93cfA4a673CE8ea106Ea1

# ===== IPFS CONFIGURATION =====
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# ===== SECURITY & ENCRYPTION =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-256-bit-encryption-key-in-hex-format
ENCRYPT_FILES=true
ENCRYPT_PATIENT_DATA=true
JWT_SECRET=your-jwt-secret-for-api-authentication

# ===== MACHINE LEARNING MODEL =====
# EfficientNet-B0 + Coordinate Attention (Histopathology only)
MODEL_PATH=../model/best_histopathology_model.pth

# ===== PRIVACY & COMPLIANCE =====
PATIENT_DATA_RETENTION_DAYS=365
AUDIT_LOGGING=true
GDPR_COMPLIANCE=true

# ===== DEVELOPMENT OPTIONS =====
MOCK_BLOCKCHAIN=true
MOCK_IPFS=false
DEBUG_FEATURE_EXTRACTION=true